{
  "name": "@invoiceninja/invoiceninja",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "production": "vite build",
    "test:e2e": "playwright test --project=chromium --workers=1",
    "test:e2e:mobile": "PLAYWRIGHT_MOBILE=1 playwright test --project=mobile-chromium --project=mobile-webkit --workers=1",
    "test:e2e:mobile:legacy": "PLAYWRIGHT_LEGACY_DIALOGS=1 npm run test:e2e:mobile",
    "test:e2e:headed": "playwright test --project=chromium --workers=1 --headed",
    "test:e2e:ui": "playwright test --project=chromium --workers=1 --ui",
    "test:e2e:report": "playwright show-report tests/e2e/report",
    "test:e2e:kill": "pkill -f 'ms-playwright/chromium|@playwright/test/cli.js (test-server|run-server)' || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.5.0",
    "laravel-vite-plugin": "^0.8.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^4.5.14",
    "vite-plugin-static-copy": "^0.17.1"
  },
  "dependencies": {
    "@checkout.com/checkout-web-components": "^1.11.0",
    "@docuninja/builder2.0": "^0.0.109",
    "axios": "^0.32",
    "card-js": "^1.0.13",
    "card-validator": "^8.1.1",
    "clipboard": "^2.0.11",
    "dialog-polyfill": "0.5.6",
    "linkify-urls": "^4.1.0",
    "sass": "^1.100.0",
    "signature_pad": "^5.1.3"
  },
  "type": "module"
}
